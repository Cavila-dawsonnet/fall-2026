#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BME280.h>

Adafruit_BME280 bme;
float temperature;


void setup(){
  Serial.begin(9600);
  Serial.println("");
  Serial.println("Program Started");
  Wire.begin();                       // starts the I2C 
  Serial.println("I2C Started");

  if (bme.begin(0x76))                // check if the BME280 sensor is connected at address 0x76
    {
     Serial.println("BME280 Found at 0x76");
    }
      else if (bme.begin(0x77))
    {
      Serial.println("BME280 Found at 0x77");
    }
    else
    {
      Serial.println("BME280 Not Found");
    }

}
 void loop(){
  temperature = bme.readTemperature(); // read temperature in Celsius
  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" C");
  delay(1000);

}
